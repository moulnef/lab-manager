<?php
// Thêm vào routes/web.php (dữ liệu giả; Ngày 3-4 Loan sẽ thay bằng Controller)

use Illuminate\Http\Request;
use Illuminate\Support\Facades\Route;

function mockDevices() {
    return json_decode(file_get_contents(public_path('devices.json')), true);
}

Route::get('/', fn () => view('devices.index', ['devices' => mockDevices()]));

Route::get('/borrow/create', fn (Request $r) => view('borrow.create', [
    'devices' => mockDevices(),
    'selectedId' => $r->query('device'),
]));

// TẠM THỜI để thử form. Khi Loan có Controller thật thì xóa route này.
Route::post('/borrow', function (Request $r) {
    $r->validate([
        'device_id' => 'required',
        'borrow_date' => 'required|date|after_or_equal:today',
        'return_date' => 'required|date|after:borrow_date',
        'reason' => 'required|min:5|max:255',
    ]);
    return redirect('/borrow/create')->with('success', 'Đã gửi yêu cầu (bản thử).');
});
