digraph ERD {
  graph [rankdir=LR, splines=spline, nodesep=0.8, ranksep=1.4, bgcolor="white", pad=0.4, fontname="Inter"];
  node  [shape=plain, fontname="Inter", fontsize=12];
  edge  [fontname="Inter", fontsize=11, color="#334155", penwidth=1.4, arrowsize=0.9];

  users [label=<
  <table border="0" cellborder="1" cellspacing="0" cellpadding="6" color="#94a3b8">
   <tr><td colspan="3" bgcolor="#1d4ed8"><font color="white"><b>users</b> (Người dùng)</font></td></tr>
   <tr><td bgcolor="#fef3c7"><b>PK</b></td><td align="left"><b>id</b></td><td align="left" port="id">BIGINT UNSIGNED</td></tr>
   <tr><td></td><td align="left">name</td><td align="left">VARCHAR(255)</td></tr>
   <tr><td>UQ</td><td align="left">email</td><td align="left">VARCHAR(255)</td></tr>
   <tr><td></td><td align="left">role</td><td align="left">VARCHAR(255) 'admin' | 'user'</td></tr>
   <tr><td></td><td align="left">password</td><td align="left">VARCHAR(255) (bcrypt)</td></tr>
   <tr><td></td><td align="left">email_verified_at</td><td align="left">TIMESTAMP NULL</td></tr>
   <tr><td></td><td align="left">remember_token</td><td align="left">VARCHAR(100) NULL</td></tr>
   <tr><td></td><td align="left">created_at, updated_at</td><td align="left">TIMESTAMP</td></tr>
  </table>>];

  categories [label=<
  <table border="0" cellborder="1" cellspacing="0" cellpadding="6" color="#94a3b8">
   <tr><td colspan="3" bgcolor="#1d4ed8"><font color="white"><b>categories</b> (Danh mục) – Bảng 1</font></td></tr>
   <tr><td bgcolor="#fef3c7"><b>PK</b></td><td align="left"><b>id</b></td><td align="left" port="id">BIGINT UNSIGNED</td></tr>
   <tr><td>UQ</td><td align="left">name</td><td align="left">VARCHAR(100)</td></tr>
   <tr><td></td><td align="left">icon</td><td align="left">VARCHAR(50) NULL</td></tr>
   <tr><td></td><td align="left">description</td><td align="left">TEXT NULL</td></tr>
   <tr><td></td><td align="left">created_at, updated_at</td><td align="left">TIMESTAMP</td></tr>
  </table>>];

  devices [label=<
  <table border="0" cellborder="1" cellspacing="0" cellpadding="6" color="#94a3b8">
   <tr><td colspan="3" bgcolor="#1d4ed8"><font color="white"><b>devices</b> (Thiết bị) – Bảng 2</font></td></tr>
   <tr><td bgcolor="#fef3c7"><b>PK</b></td><td align="left"><b>id</b></td><td align="left" port="id">BIGINT UNSIGNED</td></tr>
   <tr><td bgcolor="#dbeafe" port="cat"><b>FK</b></td><td align="left"><b>category_id</b></td><td align="left">→ categories.id (RESTRICT)</td></tr>
   <tr><td>UQ</td><td align="left">code</td><td align="left">VARCHAR(30)</td></tr>
   <tr><td></td><td align="left">name</td><td align="left">VARCHAR(255)</td></tr>
   <tr><td></td><td align="left">description</td><td align="left">TEXT NULL</td></tr>
   <tr><td></td><td align="left">image</td><td align="left">VARCHAR(255) NULL</td></tr>
   <tr><td></td><td align="left">status</td><td align="left">ENUM available | borrowed | maintenance</td></tr>
   <tr><td></td><td align="left">created_at, updated_at</td><td align="left">TIMESTAMP</td></tr>
   <tr><td></td><td align="left">deleted_at</td><td align="left">TIMESTAMP NULL (SoftDeletes)</td></tr>
  </table>>];

  transactions [label=<
  <table border="0" cellborder="1" cellspacing="0" cellpadding="6" color="#94a3b8">
   <tr><td colspan="3" bgcolor="#1d4ed8"><font color="white"><b>transactions</b> (Phiếu mượn)</font></td></tr>
   <tr><td bgcolor="#fef3c7"><b>PK</b></td><td align="left"><b>id</b></td><td align="left">BIGINT UNSIGNED</td></tr>
   <tr><td bgcolor="#dbeafe" port="user"><b>FK</b></td><td align="left"><b>user_id</b></td><td align="left">→ users.id (CASCADE)</td></tr>
   <tr><td bgcolor="#dbeafe" port="dev"><b>FK</b></td><td align="left"><b>device_id</b></td><td align="left">→ devices.id (CASCADE)</td></tr>
   <tr><td></td><td align="left">borrow_date</td><td align="left">DATE</td></tr>
   <tr><td></td><td align="left">return_date</td><td align="left">DATE</td></tr>
   <tr><td></td><td align="left">purpose</td><td align="left">VARCHAR(500) NULL</td></tr>
   <tr><td></td><td align="left">status</td><td align="left">ENUM pending | approved | returned | rejected | cancelled</td></tr>
   <tr><td></td><td align="left">approved_at</td><td align="left">TIMESTAMP NULL</td></tr>
   <tr><td></td><td align="left">returned_at</td><td align="left">TIMESTAMP NULL</td></tr>
   <tr><td></td><td align="left">admin_note</td><td align="left">VARCHAR(255) NULL</td></tr>
   <tr><td></td><td align="left">created_at, updated_at</td><td align="left">TIMESTAMP</td></tr>
  </table>>];

  { rank=same; categories; users; }
  users -> devices [style=invis];
  categories:id:e -> devices:cat:w   [dir=both, arrowtail=teetee, arrowhead=crowodot, xlabel=" 1 — n ", headlabel="", taillabel=""];
  devices:id:e -> transactions:dev:w [dir=both, arrowtail=teetee, arrowhead=crowodot, xlabel=" 1 — n "];
  users:id:e -> transactions:user:w [dir=both, arrowtail=teetee, arrowhead=crowodot, xlabel=" 1 — n "];
}
